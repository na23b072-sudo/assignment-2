import numpy as np
import matplotlib.pyplot as plt

# 1. Load the 2D grayscale array
qr_noisy = np.loadtxt('QR.txt')

# 2. Compute FFT and shift zero-frequency component to the center
F_qr = np.fft.fft2(qr_noisy)
F_shifted = np.fft.fftshift(F_qr)
magnitude_spectrum = np.log(1 + np.abs(F_shifted))

# Visualize the noisy image and its spectrum to identify noise spikes
fig, axes = plt.subplots(1, 2, figsize=(12, 6))
axes[0].imshow(qr_noisy, cmap='gray'); axes[0].set_title('Noisy QR Code')
axes[1].imshow(magnitude_spectrum, cmap='gray'); axes[1].set_title('Centered Magnitude Spectrum')
plt.show()

# 3. Manipulate the magnitude to remove noise
F_clean_shifted = np.copy(F_shifted)

# --- MANUAL MASKING STEP ---
# Look at the 'magnitude_spectrum' plot above. Identify the (y, x) coordinates 
# of the bright noise spikes (ignoring the large central bright spot). 
# Define a small window (e.g., 5x5 pixels) around those spikes and set them to 0.
# Example format:
# F_clean_shifted[y_start:y_end, x_start:x_end] = 0 
# F_clean_shifted[symmetric_y_start:symmetric_y_end, symmetric_x_start:symmetric_x_end] = 0

# 4. Inverse Transform back to spatial domain
F_clean = np.fft.ifftshift(F_clean_shifted)
qr_clean = np.real(np.fft.ifft2(F_clean))

# Visualize the cleaned QR code
plt.figure(figsize=(6, 6))
plt.imshow(qr_clean, cmap='gray')
plt.title('Denoised QR Code')
plt.axis('off')
plt.show()
