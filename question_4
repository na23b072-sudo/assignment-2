import numpy as np
import matplotlib.pyplot as plt

# 1. Load the 2D grayscale array
qr_noisy = np.loadtxt('QR.txt')

# 2. Compute FFT and shift zero-frequency component to the center
F_qr = np.fft.fft2(qr_noisy)
F_shifted = np.fft.fftshift(F_qr)
magnitude_spectrum = np.log(1 + np.abs(F_shifted))

# 3. Create a perfectly symmetric mask
rows, cols = F_shifted.shape
mask = np.ones((rows, cols), dtype=bool)

# Define a highly generous bounding box for the top-left noise block.
# Expanding the bounds ensures no high-energy slivers are left behind.
mask[100:850, 100:850] = False

# Rotate the mask 180 degrees and combine it to guarantee perfect 
# conjugate symmetry for the bottom-right block. 
symmetric_mask = mask & np.rot90(mask, k=2)

# Apply the mask to set the noise coefficients to absolute zero
F_clean_shifted = F_shifted * symmetric_mask

# 4. Inverse Transform back to spatial domain
F_clean = np.fft.ifftshift(F_clean_shifted)
qr_clean = np.real(np.fft.ifft2(F_clean))

# 5. Visualize the results
fig, axes = plt.subplots(2, 2, figsize=(12, 12))

axes[0, 0].imshow(qr_noisy, cmap='gray')
axes[0, 0].set_title('Noisy QR Code')

axes[0, 1].imshow(magnitude_spectrum, cmap='gray')
axes[0, 1].set_title('Original Magnitude Spectrum')

axes[1, 0].imshow(np.log(1 + np.abs(F_clean_shifted)), cmap='gray')
axes[1, 0].set_title('Cleaned Magnitude Spectrum')

axes[1, 1].imshow(qr_clean, cmap='gray')
axes[1, 1].set_title('Denoised QR Code')

for ax in axes.flatten():
    ax.axis('off')

plt.tight_layout()
plt.show()
