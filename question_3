import numpy as np
import matplotlib.pyplot as plt
import matplotlib.image as mpimg

# Load images and convert to grayscale by taking the mean over the RGB channels
I1_rgb = mpimg.imread('oceanCapture.jpg')
I1 = np.mean(I1_rgb, axis=-1) if I1_rgb.ndim == 3 else I1_rgb

I2_rgb = mpimg.imread('fourier.jpg')
I2 = np.mean(I2_rgb, axis=-1) if I2_rgb.ndim == 3 else I2_rgb

# 1. Compute 2D Discrete Fourier Transforms
F1 = np.fft.fft2(I1)
F2 = np.fft.fft2(I2)

# 2. Extract magnitudes and phases
mag1, phase1 = np.abs(F1), np.angle(F1)
mag2, phase2 = np.abs(F2), np.angle(F2)

# 3. Swap phases to create F3 and F4
F3 = mag1 * np.exp(1j * phase2)
F4 = mag2 * np.exp(1j * phase1)

# 4. Reconstruct images I3 and I4 using inverse FFT
I3 = np.real(np.fft.ifft2(F3))
I4 = np.real(np.fft.ifft2(F4))

# Visualization
fig, axes = plt.subplots(2, 2, figsize=(10, 10))
axes[0, 0].imshow(I1, cmap='gray'); axes[0, 0].set_title('Original I1 (oceanCapture)')
axes[0, 1].imshow(I2, cmap='gray'); axes[0, 1].set_title('Original I2 (fourier)')
axes[1, 0].imshow(I3, cmap='gray'); axes[1, 0].set_title('I3: Mag(I1) + Phase(I2)')
axes[1, 1].imshow(I4, cmap='gray'); axes[1, 1].set_title('I4: Mag(I2) + Phase(I1)')

for ax in axes.flatten():
    ax.axis('off')
plt.tight_layout()
plt.show()
